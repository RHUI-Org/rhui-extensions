#!/usr/bin/env python3

import yaml
import sys
import os
import configparser

cert_expiration_in_days = "730"


def read_config(config_path):
    global rhui_user, rhui_pass, cert_expiration_in_days
    config = configparser.ConfigParser()
    config.read(config_path)
    if "rhui" in config:
        cert_expiration_in_days = config["rhui"].get("cert_expiration", cert_expiration_in_days)

def error(msg):
    print(f"Error: {msg}", file=sys.stderr)
    sys.exit(1)

def warn(msg):
    print(f"Warning: {msg}", file=sys.stderr)


script_dir = os.path.dirname(os.path.abspath(__file__))
home_config = os.path.expanduser("~/rhui-extensions.conf")
local_config = os.path.join(script_dir, "rhui-extensions.conf")
if os.path.exists(home_config):
    read_config(home_config)
elif os.path.exists(local_config):
    read_config(local_config)
else:
    warn("There is no rhui-extensions.conf in this directory or in ~/ directory. Consider creating one based on rhui-extensions.conf-example from repository root.")


if len(sys.argv) < 2:
    error("No input file given. Usage: generate_commands <file.yaml>")

input_path = sys.argv[1]

if not os.path.exists(input_path):
    error(f"File does not exist: {input_path}")

if not os.path.isfile(input_path):
    error(f"Not a file: {input_path}")

try:
    with open(input_path, "r") as f:
        data = yaml.safe_load(f)
except yaml.YAMLError as e:
    error(f"Invalid YAML format: {e}")
except Exception as e:
    error(f"Failed to read file: {e}")

if not isinstance(data, dict):
    error("YAML content is not a dictionary. Invalid structure.")

labels = data.get("repo_labels")
if labels is None:
    error("YAML missing required key: repo_labels")
if not isinstance(labels, list):
    error("repo_labels must be a list")


generate_sync_command = True
repo_ids = data.get("repo_ids")
if repo_ids is None:
    warn("YAML missing key: repo_ids - skipping")
    generate_sync_command = False
if not isinstance(repo_ids, list):
    warn("repo_ids is not a list - skipping")
    generate_sync_command = False


filename = os.path.splitext(os.path.basename(input_path))[0]

if generate_sync_command:
    print(
        f"rhui-manager --noninteractive repo add_by_file"
        f" --file {input_path}"
    )
    print()

print(
    f"rhui-manager --noninteractive client cert"
    f" --name {filename}"
    f" --days {cert_expiration_in_days}"
    " --dir /tmp"
    f" --repo_label {','.join(labels)}"
)
print()

print(
    f"rhui-manager --noninteractive client rpm"
    f" --private_key {filename}.key"
    f" --entitlement_cert {filename}.crt"
    f" --dir /tmp --rpm_name {filename}"
)
print()

if generate_sync_command:
    print("# Syncing of ALL repos")
    print("# !!! NOTE !!! If you plan to add multiple RHEL versions/variants, run this step only after you add all repos.")
    print(f"rhui-manager --noninteractive repo sync_all")

